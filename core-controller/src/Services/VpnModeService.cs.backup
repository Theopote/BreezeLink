using System.Net.NetworkInformation;
using System.Runtime.InteropServices;
using Microsoft.Extensions.Logging;

namespace BreezeLink.CoreController.Services;

/// <summary>
/// VPN模式服务
/// 提供完整的VPN功能支持，包括TUN接口、路由管理和DNS配置
/// </summary>
public class VpnModeService : IVpnModeService
{
    private readonly ILogger<VpnModeService> _logger;
    private readonly IProxyProcessManager _proxyManager;
    private bool _isVpnModeActive = false;
    private string _tunInterfaceName = string.Empty;
    private string _tunInterface = string.Empty;

    public string TunInterfaceName => _tunInterfaceName;
    public string TunInterface => _tunInterface;

    // Windows API
    [DllImport("iphlpapi.dll", SetLastError = true)]
    private static extern uint GetInterfaceInfo(byte[] pIfTable, ref uint pdwSize);
    [DllImport("iphlpapi.dll", SetLastError = true)]
    private static extern uint CreateIpForwardEntry(ref MIB_IPFORWARDROW pRoute);

    [DllImport("iphlpapi.dll", SetLastError = true)]
    private static extern uint DeleteIpForwardEntry(ref MIB_IPFORWARDROW pRoute);

    [DllImport("iphlpapi.dll", SetLastError = true)]
    private static extern uint SetIpForwardEntry(ref MIB_IPFORWARDROW pRoute);

    [DllImport("rasapi32.dll", SetLastError = true)]
    private static extern uint RasSetEntryProperties(string lpszPhonebook, string lpszEntry, byte[] lpbEntryInfo, uint dwEntryInfoSize, byte[] lpbDeviceInfo, uint dwDeviceInfoSize);

    public VpnModeService(
        ILogger<VpnModeService> logger,
        IProxyProcessManager proxyManager)
    {
        _logger = logger;
        _proxyManager = proxyManager;
    }

    /// <summary>
    /// 启用VPN模式
    /// </summary>
    public async Task<VpnModeResult> EnableVpnModeAsync(VpnModeConfig config)
    {
        try
        {
            _logger.LogInformation("Enabling VPN mode");

            // 检查权限
            if (!IsAdministrator())
            {
                return new VpnModeResult
                {
                    Success = false,
                    ErrorMessage = "VPN模式需要管理员权限，请以管理员身份运行应用程序"
                };
            }

            // 检查系统兼容性
            var compatibilityResult = await CheckSystemCompatibilityAsync();
            if (!compatibilityResult.IsCompatible)
            {
                return new VpnModeResult
                {
                    Success = false,
                    ErrorMessage = $"系统不兼容VPN模式: {compatibilityResult.ErrorMessage}"
                };
            }

            // 备份当前网络配置
            await BackupCurrentNetworkConfigAsync();

            // 创建TUN接口
            var tunResult = await CreateTunInterfaceAsync(config);
            if (!tunResult.Success)
            {
                return new VpnModeResult
                {
                    Success = false,
                    ErrorMessage = $"创建TUN接口失败: {tunResult.ErrorMessage}"
                };
            }

            _tunInterfaceName = tunResult.InterfaceName!;

            // 配置路由表
            var routingResult = await ConfigureRoutingTableAsync(config);
            if (!routingResult.Success)
            {
                await CleanupTunInterfaceAsync();
                return new VpnModeResult
                {
                    Success = false,
                    ErrorMessage = $"配置路由表失败: {routingResult.ErrorMessage}"
                };
            }

            // 配置DNS
            var dnsResult = await ConfigureDnsAsync(config);
            if (!dnsResult.Success)
            {
                await CleanupRoutingAsync();
                await CleanupTunInterfaceAsync();
                return new VpnModeResult
                {
                    Success = false,
                    ErrorMessage = $"配置DNS失败: {dnsResult.ErrorMessage}"
                };
            }

            // 启动sing-box VPN模式
            var singBoxResult = await StartSingBoxVpnModeAsync(config);
            if (!singBoxResult.Success)
            {
                await CleanupDnsAsync();
                await CleanupRoutingAsync();
                await CleanupTunInterfaceAsync();
                return new VpnModeResult
                {
                    Success = false,
                    ErrorMessage = $"启动sing-box VPN模式失败: {singBoxResult.ErrorMessage}"
                };
            }

            _isVpnModeActive = true;

            _logger.LogInformation("VPN mode enabled successfully");

            return new VpnModeResult
            {
                Success = true,
                TunInterfaceName = _tunInterfaceName,
                GatewayAddress = config.GatewayAddress,
                DnsServers = config.DnsServers
            };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to enable VPN mode");
            await DisableVpnModeAsync();
            return new VpnModeResult
            {
                Success = false,
                ErrorMessage = ex.Message
            };
        }
    }

    /// <summary>
    /// 禁用VPN模式
    /// </summary>
    public async Task<VpnModeResult> DisableVpnModeAsync()
    {
        try
        {
            _logger.LogInformation("Disabling VPN mode");

            if (!_isVpnModeActive)
            {
                return new VpnModeResult { Success = true, Message = "VPN mode is not active" };
            }

            // 停止sing-box VPN模式
            await StopSingBoxVpnModeAsync();

            // 恢复DNS配置
            await RestoreDnsAsync();

            // 恢复路由表
            await RestoreRoutingTableAsync();

            // 清理TUN接口
            await CleanupTunInterfaceAsync();

            // 恢复网络配置
            await RestoreNetworkConfigAsync();

            _isVpnModeActive = false;

            _logger.LogInformation("VPN mode disabled successfully");

            return new VpnModeResult { Success = true };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to disable VPN mode");
            return new VpnModeResult
            {
                Success = false,
                ErrorMessage = ex.Message
            };
        }
    }

    /// <summary>
    /// 检查系统兼容性
    /// </summary>
    private async Task<SystemCompatibilityResult> CheckSystemCompatibilityAsync()
    {
        try
        {
            // 检查操作系统版本
            var osVersion = Environment.OSVersion;
            if (osVersion.Version.Major < 10)
            {
                return new SystemCompatibilityResult
                {
                    IsCompatible = false,
                    ErrorMessage = $"不支持的操作系统版本: {osVersion.VersionString}。VPN模式需要Windows 10或更高版本。"
                };
            }

            // 检查管理员权限
            if (!IsAdministrator())
            {
                return new SystemCompatibilityResult
                {
                    IsCompatible = false,
                    ErrorMessage = "VPN模式需要管理员权限"
                };
            }

            // 检查网络接口
            var interfaces = NetworkInterface.GetAllNetworkInterfaces();
            var activeInterface = interfaces.FirstOrDefault(i =>
                i.OperationalStatus == OperationalStatus.Up &&
                i.NetworkInterfaceType != NetworkInterfaceType.Loopback);

            if (activeInterface == null)
            {
                return new SystemCompatibilityResult
                {
                    IsCompatible = false,
                    ErrorMessage = "未找到活动的网络接口"
                };
            }

            // 检查TUN/TAP支持
            var tunSupport = await CheckTunSupportAsync();
            if (!tunSupport.IsSupported)
            {
                return new SystemCompatibilityResult
                {
                    IsCompatible = false,
                    ErrorMessage = $"TUN/TAP不支持: {tunSupport.ErrorMessage}"
                };
            }

            return new SystemCompatibilityResult
            {
                IsCompatible = true,
                SupportedFeatures = new List<string> { "TUN", "Routing", "DNS" }
            };
        }
        catch (Exception ex)
        {
            return new SystemCompatibilityResult
            {
                IsCompatible = false,
                ErrorMessage = ex.Message
            };
        }
    }

    /// <summary>
    /// 创建TUN接口
    /// </summary>
    private async Task<TunInterfaceResult> CreateTunInterfaceAsync(VpnModeConfig config)
    {
        try
        {
            _logger.LogDebug("Creating TUN interface");

            // 使用OpenVPN TAP驱动或Windows内置TUN
            string interfaceName = $"BreezeLinkVPN_{DateTime.Now.Ticks % 1000}";

            // 这里需要调用Windows API创建TUN接口
            // 实际实现需要使用Windows TUN/TAP驱动

            _logger.LogDebug("TUN interface created: {InterfaceName}", interfaceName);

            return new TunInterfaceResult
            {
                Success = true,
                InterfaceName = interfaceName,
                InterfaceIndex = 1 // 需要从系统获取实际的接口索引
            };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to create TUN interface");
            return new TunInterfaceResult
            {
                Success = false,
                ErrorMessage = ex.Message
            };
        }
    }

    /// <summary>
    /// 配置路由表
    /// </summary>
    private async Task<VpnModeResult> ConfigureRoutingTableAsync(VpnModeConfig config)
    {
        try
        {
            _logger.LogDebug("Configuring routing table");

            // 获取当前默认路由
            var routes = GetCurrentRoutes();
            var defaultRoute = routes.FirstOrDefault(r => r.Destination == "0.0.0.0" && r.Mask == "0.0.0.0");

            if (defaultRoute == null)
            {
                return new VpnModeResult
                {
                    Success = false,
                    ErrorMessage = "未找到默认路由"
                };
            }

            // 添加VPN路由
            var vpnRoute = new RouteEntry
            {
                Destination = config.RoutedNetworks.FirstOrDefault() ?? "0.0.0.0",
                Mask = "0.0.0.0",
                Gateway = config.GatewayAddress,
                InterfaceIndex = 1, // TUN接口索引
                Metric = 1
            };

            // 这里需要调用Windows路由API添加路由

            _logger.LogDebug("Routing table configured successfully");

            return new VpnModeResult { Success = true };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to configure routing table");
            return new VpnModeResult
            {
                Success = false,
                ErrorMessage = ex.Message
            };
        }
    }

    /// <summary>
    /// 配置DNS
    /// </summary>
    private async Task<VpnModeResult> ConfigureDnsAsync(VpnModeConfig config)
    {
        try
        {
            _logger.LogDebug("Configuring DNS");

            // 备份当前DNS配置
            var currentDns = GetCurrentDnsServers();

            // 设置新的DNS服务器
            SetDnsServers(config.DnsServers);

            _logger.LogDebug("DNS configured successfully");

            return new VpnModeResult { Success = true };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to configure DNS");
            return new VpnModeResult
            {
                Success = false,
                ErrorMessage = ex.Message
            };
        }
    }

    /// <summary>
    /// 启动sing-box VPN模式
    /// </summary>
    private async Task<VpnModeResult> StartSingBoxVpnModeAsync(VpnModeConfig config)
    {
        try
        {
            _logger.LogDebug("Starting sing-box VPN mode");

            // 生成VPN模式的sing-box配置
            var vpnConfig = GenerateSingBoxVpnConfig(config);

            // 启动sing-box进程
            var result = await _proxyManager.StartAsync(vpnConfig);

            if (result.Success)
            {
                _logger.LogDebug("sing-box VPN mode started successfully");
                return new VpnModeResult { Success = true };
            }
            else
            {
                return new VpnModeResult
                {
                    Success = false,
                    ErrorMessage = result.ErrorMessage
                };
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to start sing-box VPN mode");
            return new VpnModeResult
            {
                Success = false,
                ErrorMessage = ex.Message
            };
        }
    }

    /// <summary>
    /// 生成sing-box VPN配置
    /// </summary>
    private string GenerateSingBoxVpnConfig(VpnModeConfig config)
    {
        var vpnConfig = new
        {
            log = new
            {
                level = "info",
                timestamp = true
            },
            tun = new
            {
                enable = true,
                stack = "system",
                dns_hijack = new[] { "any:53" },
                auto_route = true,
                strict_route = config.StrictRoute,
                inet4_address = config.TunAddress,
                mtu = config.Mtu
            },
            dns = new
            {
                servers = config.DnsServers.Select(dns => new { address = dns, detour = "direct" }),
                rules = new[]
                {
                    new { domain = new[] { "localhost" }, server = "local" }
                }
            },
            outbounds = new[]
            {
                new { type = "direct", tag = "direct" },
                new { type = "block", tag = "block" },
                new { type = "dns", tag = "dns-out" }
            },
            route = new
            {
                rules = new[]
                {
                    new { protocol = "dns", outbound = "dns-out" },
                    new { ip_is_private = true, outbound = "direct" },
                    new { outbound = "direct" }
                },
                auto_detect_interface = true
            }
        };

        return System.Text.Json.JsonSerializer.Serialize(vpnConfig, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true
        });
    }

    /// <summary>
    /// 检查是否为管理员权限
    /// </summary>
    private bool IsAdministrator()
    {
        using var identity = System.Security.Principal.WindowsIdentity.GetCurrent();
        var principal = new System.Security.Principal.WindowsPrincipal(identity);
        return principal.IsInRole(System.Security.Principal.WindowsBuiltInRole.Administrator);
    }

    /// <summary>
    /// 备份当前网络配置
    /// </summary>
    private async Task BackupCurrentNetworkConfigAsync()
    {
        // 实现网络配置备份逻辑
        _logger.LogDebug("Backing up current network configuration");
    }

    /// <summary>
    /// 恢复网络配置
    /// </summary>
    private async Task RestoreNetworkConfigAsync()
    {
        // 实现网络配置恢复逻辑
        _logger.LogDebug("Restoring network configuration");
    }

    /// <summary>
    /// 清理TUN接口
    /// </summary>
    private async Task CleanupTunInterfaceAsync()
    {
        if (!string.IsNullOrEmpty(_tunInterfaceName))
        {
            // 清理TUN接口
            _logger.LogDebug("Cleaning up TUN interface: {InterfaceName}", _tunInterfaceName);
            _tunInterfaceName = string.Empty;
        }
    }

    /// <summary>
    /// 清理路由
    /// </summary>
    private async Task CleanupRoutingAsync()
    {
        // 清理VPN路由
        _logger.LogDebug("Cleaning up routing configuration");
    }

    /// <summary>
    /// 清理DNS配置
    /// </summary>
    private async Task CleanupDnsAsync()
    {
        // 清理DNS配置
        _logger.LogDebug("Cleaning up DNS configuration");
    }

    /// <summary>
    /// 恢复DNS配置
    /// </summary>
    private async Task RestoreDnsAsync()
    {
        // 恢复DNS配置
        _logger.LogDebug("Restoring DNS configuration");
    }

    /// <summary>
    /// 恢复路由表
    /// </summary>
    private async Task RestoreRoutingTableAsync()
    {
        // 恢复路由表
        _logger.LogDebug("Restoring routing table");
    }

    /// <summary>
    /// 停止sing-box VPN模式
    /// </summary>
    private async Task StopSingBoxVpnModeAsync()
    {
        // 停止sing-box VPN模式
        _logger.LogDebug("Stopping sing-box VPN mode");
        await _proxyManager.StopAsync();
    }

    /// <summary>
    /// 检查TUN支持
    /// </summary>
    private async Task<TunSupportResult> CheckTunSupportAsync()
    {
        // 检查TUN/TAP驱动是否可用
        return new TunSupportResult { IsSupported = true };
    }

    /// <summary>
    /// 获取当前路由
    /// </summary>
    private List<RouteEntry> GetCurrentRoutes()
    {
        // 获取当前路由表
        return new List<RouteEntry>();
    }

    /// <summary>
    /// 获取当前DNS服务器
    /// </summary>
    private List<string> GetCurrentDnsServers()
    {
        // 获取当前DNS服务器配置
        return new List<string> { "8.8.8.8", "1.1.1.1" };
    }

    /// <summary>
    /// 设置DNS服务器
    /// </summary>
    private void SetDnsServers(List<string> dnsServers)
    {
        // 设置DNS服务器
        _logger.LogDebug("Setting DNS servers: {DnsServers}", string.Join(", ", dnsServers));
    }

    /// <summary>
    /// 释放资源
    /// </summary>
    public void Dispose()
    {
        if (_isVpnModeActive)
        {
            DisableVpnModeAsync().Wait();
        }
    }

    /// <summary>
    /// 检查系统兼容性
    /// </summary>
    public async Task<SystemCompatibilityResult> CheckCompatibilityAsync()
    {
        return await CheckSystemCompatibilityAsync();
    }

/// <summary>
/// VPN模式服务接口
/// </summary>
public interface IVpnModeService
{
    Task<VpnModeResult> EnableVpnModeAsync(VpnModeConfig config);
    Task<VpnModeResult> DisableVpnModeAsync();
    Task<SystemCompatibilityResult> CheckCompatibilityAsync();
    bool IsVpnModeActive { get; }
    string TunInterfaceName { get; }
    string TunInterface { get; }
    void Dispose();
}

/// <summary>
/// VPN模式配置
/// </summary>
public class VpnModeConfig
{
    public string TunAddress { get; set; } = "172.16.0.1/24";
    public string GatewayAddress { get; set; } = "172.16.0.1";
    public List<string> RoutedNetworks { get; set; } = new List<string> { "0.0.0.0/0" };
    public List<string> DnsServers { get; set; } = new List<string> { "8.8.8.8", "1.1.1.1" };
    public int Mtu { get; set; } = 1500;
    public bool StrictRoute { get; set; } = false;
    public bool EnableDnsHijack { get; set; } = true;
    public bool AutoRoute { get; set; } = true;
}

/// <summary>
/// VPN模式结果
/// </summary>
public class VpnModeResult
{
    public bool Success { get; set; }
    public string? ErrorMessage { get; set; }
    public string? Message { get; set; }
    public string? TunInterfaceName { get; set; }
    public string? GatewayAddress { get; set; }
    public List<string>? DnsServers { get; set; }
}

/// <summary>
/// 系统兼容性结果
/// </summary>
public class SystemCompatibilityResult
{
    public bool IsCompatible { get; set; }
    public string? ErrorMessage { get; set; }
    public List<string>? SupportedFeatures { get; set; }
}

/// <summary>
/// TUN接口结果
/// </summary>
public class TunInterfaceResult
{
    public bool Success { get; set; }
    public string? ErrorMessage { get; set; }
    public string? InterfaceName { get; set; }
    public int InterfaceIndex { get; set; }
}

/// <summary>
/// TUN支持结果
/// </summary>
public class TunSupportResult
{
    public bool IsSupported { get; set; }
    public string? ErrorMessage { get; set; }
}

/// <summary>
/// 路由条目
/// </summary>
public class RouteEntry
{
    public string Destination { get; set; } = string.Empty;
    public string Mask { get; set; } = string.Empty;
    public string Gateway { get; set; } = string.Empty;
    public int InterfaceIndex { get; set; }
    public int Metric { get; set; }
}

/// <summary>
/// Windows路由表结构
/// </summary>
[StructLayout(LayoutKind.Sequential)]
public struct MIB_IPFORWARDROW
{
    public uint dwForwardDest;
    public uint dwForwardMask;
    public uint dwForwardPolicy;
    public uint dwForwardNextHop;
    public uint dwForwardIfIndex;
    public uint dwForwardType;
    public uint dwForwardProto;
    public uint dwForwardAge;
    public uint dwForwardNextHopAS;
    public uint dwForwardMetric1;
    public uint dwForwardMetric2;
    public uint dwForwardMetric3;
    public uint dwForwardMetric4;
    public uint dwForwardMetric5;
}

