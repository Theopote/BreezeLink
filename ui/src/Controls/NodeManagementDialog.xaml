<ContentDialog
    x:Class="BreezeLink.UI.Controls.NodeManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BreezeLink.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    Title="节点管理"
    PrimaryButtonText="关闭"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <!-- 统计信息 -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="总节点" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind ViewModel.Statistics[total], Mode=OneWay}" FontSize="24" FontWeight="Bold"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="活跃节点" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Statistics[active], Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#107C10"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="分组数" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind ViewModel.Statistics[groups], Mode=OneWay}" FontSize="24" FontWeight="Bold"/>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="测试成功" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.Statistics[success], Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#0078D4"/>
                </Grid>
            </Border>

            <!-- 工具栏 -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新数据" Command="{x:Bind ViewModel.LoadDataCommand}" Style="{ThemeResource DefaultButtonStyle}"/>
                        <Button Content="批量测试" Command="{x:Bind ViewModel.TestAllNodesCommand}" Style="{ThemeResource DefaultButtonStyle}"/>
                        <Button Content="导入配置" Command="{x:Bind ViewModel.ImportNodesCommand}" Style="{ThemeResource DefaultButtonStyle}"/>
                        <Button Content="导出配置" Command="{x:Bind ViewModel.ExportNodesCommand}" Style="{ThemeResource DefaultButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="创建分组" Command="{x:Bind ViewModel.CreateGroupCommand}" Style="{ThemeResource DefaultButtonStyle}"/>
                        <Button Content="创建节点" Command="{x:Bind ViewModel.CreateNodeCommand}" Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 分组选择 -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="选择分组" FontSize="16" FontWeight="SemiBold"/>

                    <ComboBox ItemsSource="{x:Bind ViewModel.Groups}"
                              SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              PlaceholderText="选择分组...">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 节点列表 -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="节点列表" FontSize="16" FontWeight="SemiBold"/>

                    <controls:DataGrid x:Name="NodesDataGrid"
                                     ItemsSource="{x:Bind ViewModel.Nodes}"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     SelectionMode="Single"
                                     SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                                     Height="300">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"/>
                            <controls:DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
                            <controls:DataGridTextColumn Header="服务器" Binding="{Binding Server}" Width="150"/>
                            <controls:DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="80"/>
                            <controls:DataGridTextColumn Header="延迟(ms)" Binding="{Binding LastLatency}" Width="80"/>
                            <controls:DataGridTextColumn Header="状态" Binding="{Binding TestStatus}" Width="80"/>
                            <controls:DataGridTextColumn Header="标签" Binding="{Binding Tag}" Width="100"/>
                            <controls:DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="150"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="测试选中节点"
                               Command="{x:Bind ViewModel.TestNodeCommand}"
                               CommandParameter="{x:Bind ViewModel.SelectedNode}"
                               Style="{ThemeResource DefaultButtonStyle}"/>

                        <Button Content="删除选中节点"
                               Command="{x:Bind ViewModel.DeleteNodeCommand}"
                               CommandParameter="{x:Bind ViewModel.SelectedNode}"
                               Style="{ThemeResource DefaultButtonStyle}"
                               Background="#E74856"
                               Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 创建节点表单 -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="创建新节点" FontSize="16" FontWeight="SemiBold"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Header="节点名称" PlaceholderText="输入节点名称"
                                Text="{x:Bind ViewModel.NewNodeName, Mode=TwoWay}" Margin="0,0,8,0}"/>

                        <ComboBox Grid.Row="0" Grid.Column="1" Header="节点类型"
                                 SelectedItem="{x:Bind ViewModel.SelectedNodeType, Mode=TwoWay}" Margin="8,0,0,0}">
                            <ComboBoxItem Content="Shadowsocks"/>
                            <ComboBoxItem Content="VMess"/>
                            <ComboBoxItem Content="VLESS"/>
                            <ComboBoxItem Content="Trojan"/>
                            <ComboBoxItem Content="SOCKS5"/>
                            <ComboBoxItem Content="HTTP"/>
                        </ComboBox>

                        <TextBox Grid.Row="1" Grid.Column="0" Header="服务器地址" PlaceholderText="example.com"
                                Text="{x:Bind ViewModel.NewNodeServer, Mode=TwoWay}" Margin="0,0,8,0}"/>

                        <NumberBox Grid.Row="1" Grid.Column="1" Header="端口" PlaceholderText="1080"
                                  Value="{x:Bind ViewModel.NewNodePort, Mode=TwoWay}" Minimum="1" Maximum="65535" Margin="8,0,0,0}"/>

                        <TextBox Grid.Row="2" Grid.Column="0" Header="密码/UUID" PlaceholderText="密码或UUID"
                                Text="{x:Bind ViewModel.NewNodePassword, Mode=TwoWay}" Margin="0,0,8,0}"/>

                        <TextBox Grid.Row="2" Grid.Column="1" Header="加密方法" PlaceholderText="aes-256-gcm"
                                Text="{x:Bind ViewModel.NewNodeMethod, Mode=TwoWay}" Margin="8,0,0,0}"/>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="创建节点" Command="{x:Bind ViewModel.CreateNodeCommand}" Style="{ThemeResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
