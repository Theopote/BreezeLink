<ContentDialog
    x:Class="BreezeLink.UI.Controls.NodeManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="节点管理"
    PrimaryButtonText="关闭"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="8">
            <TextBlock Text="节点列表" FontSize="16" FontWeight="SemiBold"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="刷新" Command="{x:Bind ViewModel.LoadDataCommand}"/>
                <Button Content="批量测试" Command="{x:Bind ViewModel.TestAllNodesCommand}"/>
            </StackPanel>

            <ListView ItemsSource="{x:Bind ViewModel.Nodes}"
                      SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                      Height="280">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding Name}" Width="120"/>
                            <TextBlock Text="{Binding Type}" Width="80"/>
                            <TextBlock Text="{Binding Server}" Width="140"/>
                            <TextBlock Text="{Binding Port}" Width="60"/>
                            <TextBlock Text="{Binding LastLatency}" Width="60"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="测试选中" Command="{x:Bind ViewModel.TestNodeCommand}" CommandParameter="{x:Bind ViewModel.SelectedNode}"/>
                <Button Content="删除选中" Command="{x:Bind ViewModel.DeleteNodeCommand}" CommandParameter="{x:Bind ViewModel.SelectedNode}"/>
            </StackPanel>

            <TextBlock Text="创建节点" FontSize="16" FontWeight="SemiBold"/>

            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" Header="名称" Text="{x:Bind ViewModel.NewNodeName, Mode=TwoWay}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Header="服务器" Text="{x:Bind ViewModel.NewNodeServer, Mode=TwoWay}"/>
                <NumberBox Grid.Row="1" Grid.Column="0" Header="端口" Value="{x:Bind ViewModel.NewNodePort, Mode=TwoWay}" Minimum="1" Maximum="65535"/>
                <TextBox Grid.Row="1" Grid.Column="1" Header="密码" Text="{x:Bind ViewModel.NewNodePassword, Mode=TwoWay}"/>
                <Button Grid.Row="2" Grid.Column="1" Content="创建节点" Command="{x:Bind ViewModel.CreateNodeCommand}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
