<Window
    x:Class="BreezeLink.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BreezeLink">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="BreezeLink" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="智能代理客户端" Opacity="0.7"/>
        </StackPanel>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
                 Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                 IsClosable="True"/>

        <Border Grid.Row="2" Padding="12" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="代理状态" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind ViewModel.TrafficText, Mode=OneWay}" Opacity="0.8" FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Padding="12" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="运行日志" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="清空日志"
                            HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.ClearLogsCommand}"/>
                </Grid>
                <TextBox Grid.Row="1"
                         Margin="0,8,0,0"
                         Text="{x:Bind ViewModel.LogsText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
            <Button Content="{x:Bind ViewModel.StartButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.StartProxyCommand}"
                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="{x:Bind ViewModel.StopButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.StopProxyCommand}"
                    IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"/>
            <Button Content="重载配置"
                    Command="{x:Bind ViewModel.ReloadProxyCommand}"
                    IsEnabled="{x:Bind ViewModel.CanReload, Mode=OneWay}"/>
            <Button Content="刷新状态" Command="{x:Bind ViewModel.RefreshStatusCommand}"/>
            <Button Content="节点管理" Click="NodeManagementButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
