<Window
    x:Class="BreezeLink.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BreezeLink.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="BreezeLink - 智能代理客户端">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Enhanced Title Bar -->
        <Border Grid.Row="0" Background="{ThemeResource AccentFillColorDefaultBrush}" Height="56">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/Square44x44Logo.png" Width="32" Height="32" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="BreezeLink" FontSize="20" FontWeight="Bold"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        <TextBlock Text="智能代理客户端" FontSize="12" Opacity="0.8"
                                  Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button x:Name="DashboardButton" Content="仪表板"
                           Style="{StaticResource NavigationButtonStyle}"
                           Background="{ThemeResource SystemAccentColor}"
                           Command="{x:Bind ViewModel.NavigateToDashboardCommand}"/>

                    <Button x:Name="NodesButton" Content="节点管理"
                           Style="{StaticResource NavigationButtonStyle}"
                           Command="{x:Bind ViewModel.NavigateToNodesCommand}"/>

                    <Button x:Name="RulesButton" Content="规则管理"
                           Style="{StaticResource NavigationButtonStyle}"
                           Command="{x:Bind ViewModel.NavigateToRulesCommand}"/>

                    <Button x:Name="DiagnosticsButton" Content="诊断工具"
                           Style="{StaticResource NavigationButtonStyle}"
                           Command="{x:Bind ViewModel.NavigateToDiagnosticsCommand}"/>

                    <Button x:Name="SettingsButton" Content="设置"
                           Style="{StaticResource NavigationButtonStyle}"
                           Command="{x:Bind ViewModel.NavigateToSettingsCommand}"/>
                </StackPanel>

                <!-- Status and Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="12">
                    <!-- Connection Status -->
                    <Border Background="{x:Bind ViewModel.IsProxyRunning, Mode=OneWay, Converter={StaticResource BoolToStatusColorConverter}}"
                           CornerRadius="12" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{x:Bind ViewModel.IsProxyRunning, Mode=OneWay, Converter={StaticResource BoolToIndicatorColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}"
                                      FontSize="12" FontWeight="Medium"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions -->
                    <Button x:Name="QuickConnectButton"
                           Content="⚡"
                           Style="{StaticResource IconButtonStyle}"
                           ToolTipService.ToolTip="快速连接"
                           Command="{x:Bind ViewModel.QuickConnectCommand}"/>

                    <Button x:Name="RefreshButton"
                           Content="🔄"
                           Style="{StaticResource IconButtonStyle}"
                           ToolTipService.ToolTip="刷新"
                           Command="{x:Bind ViewModel.RefreshCommand}"/>

                    <Button x:Name="ThemeToggleButton"
                           Content="🌙"
                           Style="{StaticResource IconButtonStyle}"
                           ToolTipService.ToolTip="切换主题"
                           Command="{x:Bind ViewModel.ToggleThemeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <NavigationView x:Name="MainNavigationView"
                       Grid.Row="1"
                       IsBackButtonVisible="Collapsed"
                       PaneDisplayMode="Left"
                       OpenPaneLength="280"
                       SelectionChanged="NavigationView_SelectionChanged"
                       Background="{ThemeResource LayerFillColorDefaultBrush}">

            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="仪表板" Tag="Dashboard"/>
                <NavigationViewItem Icon="List" Content="节点管理" Tag="Nodes"/>
                <NavigationViewItem Icon="Filter" Content="规则管理" Tag="Rules"/>
                <NavigationViewItem Icon="Setting" Content="系统设置" Tag="Settings"/>
                <NavigationViewItem Icon="Help" Content="帮助文档" Tag="Help"/>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Spacing="8" Margin="0,0,0,16">
                    <NavigationViewItem Icon="Contact" Content="关于" Tag="About"/>
                    <TextBlock Text="BreezeLink v0.8"
                              FontSize="11"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </NavigationView.PaneFooter>

            <ScrollViewer Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status Cards -->
                    <ItemsControl Grid.Row="0" ItemsSource="{x:Bind ViewModel.StatusCards, Mode=OneWay}" Margin="16,16,16,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusCardStyle}" Margin="0,0,8,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Icon}" FontSize="16"/>
                                            <TextBlock Text="{Binding Title}"
                                                     FontSize="14" FontWeight="SemiBold"
                                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="{Binding Value}"
                                                  FontSize="24" FontWeight="Bold"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Margin="0,8,0,4"/>

                                        <TextBlock Grid.Row="2" Text="{Binding Description}"
                                                  FontSize="11"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Main Content -->
                    <ContentControl Grid.Row="1" x:Name="MainContentControl" Margin="16,8,16,16">
                        <!-- Default Dashboard Content -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Welcome Section -->
                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="欢迎使用 BreezeLink" FontSize="24" FontWeight="Bold"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <TextBlock Text="BreezeLink 是一个功能强大的代理客户端，支持多种代理协议，提供直观的管理界面和丰富的功能。"
                                              TextWrapping="Wrap"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="开始使用" Style="{ThemeResource AccentButtonStyle}"
                                               Command="{x:Bind ViewModel.GetStartedCommand}"/>

                                        <Button Content="查看文档" Style="{ThemeResource DefaultButtonStyle}"
                                               Command="{x:Bind ViewModel.ViewDocumentationCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Quick Actions Grid -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="快速操作" FontSize="18" FontWeight="SemiBold"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 1 -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ActionCardStyle}" Margin="0,0,8,8">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="🔗" FontSize="24" HorizontalAlignment="Center"/>
                                            <TextBlock Text="节点管理" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="管理代理节点和配置" FontSize="11" HorizontalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Button Content="打开" Style="{StaticResource CardButtonStyle}"
                                                   Command="{x:Bind ViewModel.OpenNodeManagementCommand}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ActionCardStyle}" Margin="0,0,8,8">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="⚙️" FontSize="24" HorizontalAlignment="Center"/>
                                            <TextBlock Text="系统设置" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="配置系统参数" FontSize="11" HorizontalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Button Content="打开" Style="{StaticResource CardButtonStyle}"
                                                   Command="{x:Bind ViewModel.OpenSettingsCommand}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ActionCardStyle}" Margin="0,0,0,8">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center"/>
                                            <TextBlock Text="数据分析" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="查看统计和报告" FontSize="11" HorizontalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Button Content="打开" Style="{StaticResource CardButtonStyle}"
                                                   Command="{x:Bind ViewModel.OpenAnalyticsCommand}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 2 -->
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ActionCardStyle}" Margin="0,0,8,0">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="🔒" FontSize="24" HorizontalAlignment="Center"/>
                                            <TextBlock Text="VPN模式" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="启用VPN功能" FontSize="11" HorizontalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Button Content="启用" Style="{StaticResource CardButtonStyle}"
                                                   Command="{x:Bind ViewModel.EnableVPNCommand}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionCardStyle}" Margin="0,0,8,0">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center"/>
                                            <TextBlock Text="网络诊断" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="诊断网络问题" FontSize="11" HorizontalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Button Content="诊断" Style="{StaticResource CardButtonStyle}"
                                                   Command="{x:Bind ViewModel.RunDiagnosticsCommand}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionCardStyle}" Margin="0,0,0,0">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="📱" FontSize="24" HorizontalAlignment="Center"/>
                                            <TextBlock Text="插件管理" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="管理插件系统" FontSize="11" HorizontalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Button Content="管理" Style="{StaticResource CardButtonStyle}"
                                                   Command="{x:Bind ViewModel.OpenPluginManagerCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- System Information -->
                            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="系统信息" FontSize="16" FontWeight="SemiBold"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="运行状态" FontSize="12" FontWeight="SemiBold"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind ViewModel.SystemStatus, Mode=OneWay}"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="运行时间" FontSize="12" FontWeight="SemiBold"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind ViewModel.Uptime, Mode=OneWay}"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="内存使用" FontSize="12" FontWeight="SemiBold"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind ViewModel.MemoryUsage, Mode=OneWay}"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="CPU使用率" FontSize="12" FontWeight="SemiBold"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind ViewModel.CpuUsage, Mode=OneWay}"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ContentControl>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <!-- Enhanced Footer -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
               BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
               BorderThickness="0,1,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="BreezeLink v0.8 - 智能代理客户端"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Text="•"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorDisabledBrush}"/>

                    <TextBlock Text="开源项目"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Text="•"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorDisabledBrush}"/>

                    <TextBlock Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="GitHub"
                           Style="{StaticResource LinkButtonStyle}"
                           Command="{x:Bind ViewModel.OpenGitHubCommand}"/>

                    <Button Content="文档"
                           Style="{StaticResource LinkButtonStyle}"
                           Command="{x:Bind ViewModel.OpenDocumentationCommand}"/>

                    <Button Content="支持"
                           Style="{StaticResource LinkButtonStyle}"
                           Command="{x:Bind ViewModel.OpenSupportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
